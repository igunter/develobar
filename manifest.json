{
  "manifest_version": 3,
  "name": "Develobar",
  "version": "1.0.0",
  "description": "A developer toolbar for any web page: screenshot, colour picker, measure and inspect.",

  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },

  "action": {
    "default_title": "Toggle Develobar",
    "default_icon": {
      "16": "assets/icon.png",
      "32": "assets/icon.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": ["activeTab", "scripting", "storage", "cookies"],

  "optional_host_permissions": ["*://*/*"],

  "web_accessible_resources": [
    {
      "resources": ["toolbar/toolbar.html", "toolbar/toolbar.css", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle Develobar"
    }
  }
}
